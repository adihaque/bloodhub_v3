# Blood Hub Environment Configuration Template
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY_MIN_32_CHARS

# Database: keep sqlite locally; use Neon pooled URL in production
DATABASE_BACKEND=sqlite
DATABASE_URL=sqlite:///data/bloodhub_dev.db
NEON_DATABASE_URL=
POSTGIS_ENABLED=false

# Optional Upstash Redis
REDIS_ENABLED=false
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Notifications (safe mocks by default)
SMS_PROVIDER=mock
SMS_GATEWAY_API_KEY=
SMS_GATEWAY_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
WHATSAPP_FROM_NUMBER=
FCM_PROVIDER=mock
FCM_PROJECT_ID=
FCM_CREDENTIALS_JSON=

# Persistent device sessions
SESSION_TOKEN_EXPIRE_DAYS=30
SESSION_TOKEN_BYTES=32

GEOCODING_PROVIDER=osm
MAPS_API_KEY=
WORKER_POLL_INTERVAL=5
