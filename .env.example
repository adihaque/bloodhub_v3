# Blood Hub Environment Configuration Template
# Copy this file to .env and configure values before production deployment.

APP_ENV=development
DEBUG=true

# Security (MUST BE REPLACED WITH SECURE 32+ CHAR HEX STRING IN PRODUCTION)
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY_MIN_32_CHARS

# Database
# Production: postgresql://user:password@postgres:5432/bloodhub
# Development / Local: sqlite:////tmp/bloodhub.db
DATABASE_URL=sqlite:////tmp/bloodhub.db

# Bangladesh Telecom / SMS Gateway (SSL Wireless / Greenweb)
SMS_PROVIDER=mock
SMS_GATEWAY_API_KEY=CHANGE_ME_SMS_GATEWAY_API_KEY
SMS_GATEWAY_SID=CHANGE_ME_SMS_SID

# Push Notifications (Firebase Cloud Messaging)
FCM_PROJECT_ID=CHANGE_ME_FIREBASE_PROJECT_ID
FCM_CREDENTIALS_JSON=CHANGE_ME_FIREBASE_SERVICE_ACCOUNT_PATH

# Geocoding / Maps
GEOCODING_PROVIDER=osm
MAPS_API_KEY=CHANGE_ME_MAPS_API_KEY_IF_USING_GOOGLE_OR_BARIKOI

# Operational Settings
WORKER_POLL_INTERVAL=5
